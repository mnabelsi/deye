# Copy to .env for local runs. On Hostinger, enter these in the Node.js app's
# "Environment variables" section (or use "Import .env").

# --- MySQL (required) — create the database in hPanel → Databases → Management
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_deye
DB_USER=u123456789_deye
DB_PASSWORD=change-me
# Alternatively a single URL instead of the five values above:
# DATABASE_URL=mysql://u123456789_deye:change-me@localhost:3306/u123456789_deye

# --- Optional
# PORT=3000                 # Hostinger sets this automatically
# SESSION_SECRET=           # generated and stored in MySQL if empty
# CRON_KEY=                 # secret for /api/cron/collect; generated if empty
# DISABLE_SCHEDULER=0       # set to 1 to collect only via cron
# TRUST_PROXY=1

# --- Optional DeyeCloud defaults (normally entered on the Settings page instead)
# DEYE_BASE_URL=https://eu1-developer.deyecloud.com/v1.0
# DEYE_APP_ID=
# DEYE_APP_SECRET=
# DEYE_EMAIL=
# DEYE_PASSWORD=
# DEYE_COMPANY_ID=
