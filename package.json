{
  "name": "deye-solar-monitor",
  "version": "1.0.0",
  "description": "Self-hosted dashboard that collects, stores and charts every reading from Deye inverters via the DeyeCloud OpenAPI.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "collect": "node scripts/collect.js",
    "backfill": "node scripts/backfill.js",
    "mock": "node scripts/mock-deye.js",
    "check": "node --check server.js && node scripts/check-syntax.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.0",
    "dotenv": "^16.4.7",
    "echarts": "^5.6.0",
    "express": "^5.1.0",
    "mysql2": "^3.14.0"
  },
  "license": "MIT"
}
